# Cicumpunct Δ/its_just_luck
# Date: 06-5-2025

# Disable Status Bar
%wd

# Clear Backdrop
%X(d)

# Preload Fonts
%Fl(2,29-squaredot.fnt)
%Fl(3,14-LanaPixel.fnt)
%Fl(4,10-Sazanami-Mincho.fnt)
%Fl(5,07-LanaPixel.fnt)
%Fl(6,21-LanaPixel.fnt)
%Fl(7,20-digital7mono.fnt)

# Preload Images
%xl(battery,battery.bmp,0,0,10)
%xl(playmodes,playmodes.bmp,0,0,9)
%xl(pbbd,progressbar_backdrop.bmp,0,0)
%xl(pl,pl.bmp,0,0)
%xl(plbg,plbg.bmp,0,0)
%xl(pr,pr.bmp,0,0)
%xl(prbg,prbg.bmp,0,0)
%xl(volbg,volbg.bmp,0,0)
%xl(vol,vol.bmp,0,0)
%xl(load,loadstatus.bmp,10)
%xl(A,aa.bmp,0,0)

# Display Viewports
%?mh<%Vd(lockscreen)|%Vd(metadata)>

##################################
##### Locked (BW Monochrome) #####
##################################

# Clear Display
%Vl(lockscreen,0,0,320,240,-)
%Vb(121a00)%Vf(B5FF00)

# Clock
%Vl(lockscreen,20,160,180,80,6)
%Vb(121a00)%Vf(B5FF00)
%al%cl:%cM%cp

# Day
%Vl(lockscreen,20,140,160,-,5)
%Vb(121a00)%Vf(B5FF00)
%al%?cu<Monday|Tuesday|Wednesday|Thursday|Friday|Saturday|Sunday>, %cb %cd

# Battery Indicator
%Vl(lockscreen,220,160,80,-,6)
%Vb(121a00)%Vf(B5FF00)
%ar%bl%%

# Charging Indicator
%Vl(lockscreen,220,140,80,-,5)
%Vb(121a00)%Vf(B5FF00)
%ar%?bc<Charging|Voltage>

# Lock Indicator
%Vl(lockscreen,215,45,85,25,7)
%Vb(7b007b)%Vf(121a00)
%ac%?mh<LOCKED%Vs(invert)|>

# Album Artist
%Vl(lockscreen,20,38,200,30,3)
%Vb(121a00)%Vf(ff2400)
%al%s%ia

# Track Title or Filename
%Vl(lockscreen,20,65,280,30,2)
%Vb(121a00)%Vf(B5FF00)
%al%s%it

# Album Title and ID3 Year
%Vl(lockscreen,20,105,190,15,5)
%Vb(121a00)%Vf(B5FF00)
%al%s%id %(%ss(0,4, %iy)%)

# Shuffle Indicator
%Vl(lockscreen,220,109,20,12,4)
%Vf(ff2400)
%al%?ps<SHUF>

# Repeat Indicator
%Vl(lockscreen,245,109,32,12,4)
%Vf(ff2400)
%ac%?mm<|REPEAT|REPEAT|REPEAT|REPEAT>

# Repeat Mode Indicator
%Vl(lockscreen,284,109,20,12,4)
%Vf(ff2400)
%ar%?mm<|ALL|ONE|SHUF|A-B>

#######################
##### Play Screen #####
#######################

# Clear Display
%Vl(metadata,0,0,320,240,-)
%dr(161,5,144,26,103000)
%dr(15,5,144,26,103000)
%dr(15,40,290,85,103000)
%dr(15,135,290,57,103000)
%dr(15,200,290,25,103000)

# Playback Mode Icons
%Vl(metadata,20,12,25,13,-)
%Vf(B5FF00)%Vb(103000)
%xd(playmodes,%mp)

# Track Number
%Vl(metadata,45,10,80,19,5)
%Vf(ff2400)%Vb(103000)
%al%pp %Sx(of) %pe

# Clock
%Vl(metadata,220,10,50,15,5)
%Vf(ff2400)%Vb(103000)
%ac%cl:%cM%cp

# Load Indicator
%?lh<%Vd(loadstatus)|%Vd(loadstatic)>
%Vl(loadstatic,152,10,16,16,-)
%Vf(7b007b)%Vb(121a00)
%xd(load,1)
%Vl(loadstatus,152,10,16,16,-)
%Vf(7b007b)%Vb(121a00)
%t(0.2)%xd(load,2);%t(0.2)%xd(load,3);%t(0.2)%xd(load,4);%t(0.2)%xd(load,5);%t(0.2)%xd(load,6);%t(0.2)%xd(load,7);%t(0.2)%xd(load,8);%t(0.2)%xd(load,9);%t(0.3)%xd(load,10);%t(0.3)%xd(load,9)%t(0.3)%xd(load,8);%t(0.2)%xd(load,9);%t(0.2)%xd(load,10);%t(0.2)%xd(load,9);%t(0.2)%xd(load,8);%t(0.2)%xd(load,7);%t(0.2)%xd(load,6);%t(0.2)%xd(load,5);%t(0.2)%xd(load,4);%t(0.1)%xd(load,3);%t(0.1)%xd(load,2);%t(0.2)%xd(load,1)

# Battery (graphical)
%Vl(metadata,277,13,23,10,-)
%?if(%bl,>,90)<%xd(battery,10)|%?if(%bl,>,80)<%xd(battery,9)|%?if(%bl,>,70)<%xd(battery,8)|%?if(%bl,>,60)<%xd(battery,7)|%?if(%bl,>,50)<%xd(battery,6)|%?if(%bl,>,40)<%xd(battery,5)|%?if(%bl,>,30)<%xd(battery,4)|%?if(%bl,>,20)<%xd(battery,3)|%?if(%bl,>,10)<%xd(battery,2)|%?if(%bl,>,-1)<%xd(battery,1)>>>>>>>>>>
%Vf(B5FF00)%Vb(103000)

#Art
%Cl(0,0,85,85,l,t)
%Vl(metadata,15,40,85,85,-)
%Vf(290400)%Vb(ffa600)
%?C<%Cd|%xd(A)>

# Album Artist
%Vl(metadata,104,40,112,30,3)
%Vf(B5FF00)%Vb(103000)
%al%s%ia

# Codec
%Vl(metadata,219,46,40,15,7)
%Vf(121a00)%Vb(7b007b)
%ac%?fc<MP1|MP2|MP3|AIFF|WAV|VORBIS|FLAC|MPC|AC3|WAVPAC|ALAC|AAC|SHORTEN|SID|ADX|NSF|SPEEX|SPC|APE|WMA|WMAPRO|MOD|SAP|COOK|AAC|AC3|ATRAC3|CMC|CM3|CMR|CMS|DMC|DLT|MPT|MPD|RMT|TMC|TM8|TM2|ATRAC3|SMAF|AU|VOX|WAVE64|TRUEAUD|WMAVOX|MUSEPAK|AAC-HE|AY|VTX|GBS|HES|SGC|VGM|KSS|OPUS|AAC|UNKNOWN?>%Vs(invert)%s

# Bitrate
%Vl(metadata,262,46,40,15,7)
%Vf(121a00)%Vb(7b007b)
%ac%fbk%Vs(invert)%s

# Track Title or Filename
%Vl(metadata,104,67,198,30,2)
%Vf(B5FF00)%Vb(103000)
%al%s%it

# Album Title and ID3 Year
%Vl(metadata,104,107,112,15,5)
%Vf(B5FF00)%Vb(103000)
%al%s%id %(%ss(0,4, %iy)%)

# Shuffle Indicator
%Vl(metadata,224,111,20,10,4)
%Vf(ff2400)%Vb(121a00)
%al%?ps<SHUF>

# Repeat Indicator
%Vl(metadata,247,111,32,10,4)
%Vf(ff2400)%Vb(121a00)
%ac%?mm<|REPEAT|REPEAT|REPEAT|REPEAT>

# Repeat Mode Indicator
%Vl(metadata,282,111,20,10,4)
%Vf(ff2400)%Vb(121a00)
%ar%?mm<|ALL|ONE|SHUF|A-B>

# Peak Meters
# Left
%Vl(metadata,20,140,140,30,-)
%Vf(7b007b)%Vb(103000)
%pL(0,0,140,30,image,pl,backdrop,plbg,invert)

# Right
%Vl(metadata,160,140,140,30,-)
%Vf(7b007b)%Vb(103000)
%pR(0,0,140,30,image,pr,backdrop,prbg)

# Volume Level Text
%Vl(metadata,260,178,40,10,4)
%Vf(ff2400)%Vb(103000)
%ac%?if(%pv, >, 0)<+|>%pvdB

%Vl(metadata,30,178,35,10,4)
%Vf(ff2400)%Vb(103000)
%alVOL-

# Volume Bar
%Vl(metadata,60,182,200,2,-)
%Vf(B5FF00)%Vb(103000)
%pv(0,0,200,1,vol,backdrop,volbg)

# Time Elapsed
%Vl(metadata,18,205,35,15,7)
%Vf(B5FF00)%Vb(103000)
%al%pc

# Progress Bar
%Vl(metadata,60,208,200,11,-)
%Vf(ff2400)%Vb(103000)
%pb(0,0,200,9,progressbar.bmp,backdrop,pbbd)

# Total Track Time
%Vl(metadata,266,205,35,15,7)
%Vf(B5FF00)%Vb(103000)
%ac%pt